# Copy this file to .env and replace the example values with your local settings.
# Do not commit .env or put production credentials in this file.

ENVIRONMENT=development
APP_NAME="Folio Desk"
BASE_URL=http://localhost:8000
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256

# Local PostgreSQL database and Redis instance.
# The database must already exist and be reachable before starting the API.
DEV_DB_URL=postgresql://<user>:<password>@localhost:5432/folio_desk
DEV_REDIS_URL=redis://localhost:6379/1

# Set this to the origin of your local frontend. Avoid wildcard origins in production.
DEV_ORIGINS=http://localhost:3000

# Production settings (used when ENVIRONMENT=production).
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
# REDIS_URL=redis://<host>:6379/0
# ORIGINS=https://your-frontend.example

# Optional email-provider settings. Configure only when email functionality is used.
# RESEND_API_KEY=replace_with_provider_key
# SMTP_SERVER=your_smtp_server
# EMAIL_USERNAME=your_email_username
# EMAIL_PASSWORD=replace_with_email_password
# API_URL=your_email_provider_api_url
# API_AUTHORIZATION_KEY=replace_with_provider_authorization_key
