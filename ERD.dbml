Enum user_role { 
  admin
  client
}

Enum client_tier {
  standard
  retainer
  premium
}

Enum project_status {
  active
  maintenance
  paused
  archived
}

Enum request_type {
  bug
  update
  feature
}

Enum request_status {
  new
  triaged
  in_progress
  awaiting_client
  done
  rejected
  cancelled
}

Table clients {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(150) [not null]
  contact_email varchar(255) [not null]
  tier client_tier [not null, default: 'standard']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  client_id uuid [note: 'null for admin']
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role user_role [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  indexes { client_id }
}

Table invite_codes {
  id uuid [pk, default: `gen_random_uuid()`]
  client_id uuid [not null]
  code_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  used_by uuid
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table projects {
  id uuid [pk, default: `gen_random_uuid()`]
  client_id uuid [not null]
  name varchar(150) [not null]
  description text
  stack varchar(255)
  live_url varchar(500)
  status project_status [not null, default: 'active']
  is_public boolean [not null, default: false]
  public_summary text
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (client_id, name) [unique]
    is_public
  }
}

Table requests {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null]
  created_by uuid [not null]
  title varchar(200) [not null]
  description text [not null]
  type request_type [not null]
  status request_status [not null, default: 'new']
  effort_hours numeric(5,1)
  pinned boolean [not null, default: false]
  rejection_reason text
  created_at timestamptz [not null, default: `now()`]
  closed_at timestamptz
  indexes { project_id status type created_by }
}

Table comments {
  id uuid [pk, default: `gen_random_uuid()`]
  request_id uuid [not null]
  author_id uuid [not null]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes { request_id }
}

Ref: users.client_id > clients.id [delete: restrict]
Ref: invite_codes.client_id > clients.id [delete: restrict]
Ref: invite_codes.used_by - users.id [delete: set null]
Ref: projects.client_id > clients.id [delete: restrict]
Ref: requests.project_id > projects.id [delete: restrict]
Ref: requests.created_by > users.id [delete: restrict]
Ref: comments.request_id > requests.id [delete: cascade]
Ref: comments.author_id > users.id [delete: restrict]